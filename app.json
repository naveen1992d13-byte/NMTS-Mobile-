{
  "expo": {
    "name": "Sleeping Stock Mobile",
    "slug": "sleeping-stock-mobile",
    "version": "1.3.7",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070d"
    },
    "android": {
      "package": "in.sleepingstock.mobile",
      "versionCode": 13,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070d"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sleeping Stock Mobile to scan pairing codes and part numbers.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-av",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3ee0ff",
          "defaultChannel": "sleeping-stock-requests-v3",
          "sounds": [
            "./assets/sounds/sleeping_stock_alert_2_rising_dispatch.wav"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "545530df-24b8-4e30-a35d-0fb66b3c3f81"
      }
    },
    "owner": "naveensleep"
  }
}
