{
  "expo": {
    "name": "Sleeping Stock Mobile",
    "slug": "sleeping-stock-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#050706"
    },
    "android": {
      "package": "in.sleepingstock.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050706"
      }
    },
    "extra": {
      "apiBaseUrl": "https://your-nmts-domain.example.com/api",
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sleeping Stock Mobile to scan pairing codes and part numbers."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#176b43"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://your-nmts-domain.example.com/api",
      "eas": {
        "projectId": "545530df-24b8-4e30-a35d-0fb66b3c3f81"
      }
    },
    "owner": "naveensleep"
  }
}
