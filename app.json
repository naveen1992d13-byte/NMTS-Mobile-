{
  "expo": {
    "name": "Sleeping Stock Mobile",
    "slug": "sleeping-stock-mobile",
    "version": "1.4.9",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070d"
    },
    "android": {
      "package": "in.sleepingstock.mobile",
      "versionCode": 31,
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/source/sleeping-stock-app-icon-safe-zone.png",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "USE_FULL_SCREEN_INTENT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/source/adaptive-icon-foreground-logo-only.png",
        "backgroundImage": "./assets/source/adaptive-icon-background.png"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sleeping Stock Mobile to scan pairing codes and part numbers.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Sleeping Stock Mobile to enter part numbers by voice.",
          "speechRecognitionPermission": "Allow Sleeping Stock Mobile to convert speech into a part number.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-av",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3ee0ff",
          "defaultChannel": "sleeping-stock-requests-v3",
          "sounds": [
            "./assets/sounds/sleeping_stock_alert_2_rising_dispatch.wav"
          ]
        }
      ],
      "./plugins/withInsistentRequestNotifications.js",
      "./plugins/withNativeRequestAlert.js"
    ],
    "extra": {
      "eas": {
        "projectId": "545530df-24b8-4e30-a35d-0fb66b3c3f81"
      }
    },
    "owner": "naveensleep"
  }
}
