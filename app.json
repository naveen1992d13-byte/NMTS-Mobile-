{
  "expo": {
    "name": "Sleeping Stock Mobile",
    "slug": "sleeping-stock-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "newArchEnabled": true,
    "android": {
      "package": "in.sleepingstock.mobile",
      "versionCode": 2,
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#176b43",
          "defaultChannel": "nmts-alerts"
        }
      ],
      [
  "expo-build-properties",
  {
    "android": {
      "minSdkVersion": 26
    }
  }
]
    ],
    "extra": {
      "apiUrl": "https://your-domain.example/api/mobile/v2",
      "eas": {
        "projectId": "545530df-24b8-4e30-a35d-0fb66b3c3f81"
      }
    },
    "owner": "naveensleep",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    }
  }
}
